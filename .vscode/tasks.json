{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Server",
      "type": "npm",
      "script": "dev",
      "problemMatcher": [],
      "presentation": {
        "group": "development",
        "reveal": "always"
      }
    },
    {
      "label": "Preview",
      "type": "npm",
      "script": "preview",
      "problemMatcher": [],
      "presentation": {
        "group": "development",
        "reveal": "always"
      }
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "problemMatcher": []
    },
    {
      "label": "Format Check",
      "type": "npm",
      "script": "format:check",
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "npm",
      "script": "typecheck",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Lint Fix",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": "$eslint-stylish"
    },
    {
      "label": "Test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Test Watch",
      "type": "npm",
      "script": "test:watch",
      "problemMatcher": []
    },
    {
      "label": "Test E2E",
      "type": "npm",
      "script": "test:e2e",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test E2E UI",
      "type": "npm",
      "script": "test:e2e:ui",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "Verify",
      "type": "npm",
      "script": "verify",
      "problemMatcher": ["$tsc", "$eslint-stylish"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "group": "verification",
        "reveal": "always"
      }
    }
  ]
}
