# Normalize all text to LF in the repository and in every working tree.
# Prettier is configured with endOfLine: "lf"; without this, a Windows
# checkout under core.autocrlf=true produces CRLF files that fail
# `npm run format:check` and therefore `npm run verify`.
* text=auto eol=lf

# Binary assets: never convert.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
